# Copy this file to .env and fill in the real values. Never commit .env.

# Highlightly API
HIGHLIGHTLY_API_KEY=

# Basketball database (Postgres on the host machine)
# Inside the Airflow containers DB_HOST is overridden by docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_intelligence_db
DB_USER=
DB_PASSWORD=

# backfill.py (set QUOTA_RESERVE=10 while backfilling so the daily job has room)
BACKFILL_STOP_DATE=2024-01-01
QUOTA_RESERVE=1

# Airflow (generate each secret; see the commands in the project notes)
# FERNET_KEY: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# the other secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_UID=50000
